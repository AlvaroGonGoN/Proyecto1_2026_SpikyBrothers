using System.Collections;
using UnityEngine;

public class EnemyController : MonoBehaviour
{
    [Header("Movimiento")]
    public float moveSpeed = 3f;
    public float detectRange = 6f;
    public float attackRange = 1.5f;

    [Header("Límites de la calle")]
    public float xMin = -8f;
    public float xMax = 8f;
    public float floorMin = -2.5f;
    public float floorMax = -0.5f;

    [Header("Combate")]
    public float attackCooldown = 1.2f;
    public float attackDamage = 10f;
    public float knockbackForce = 4f;

    [Header("Hitbox")]
    public GameObject hitboxPrefab;
    public Transform hitboxSpawnPoint;
    public Vector2 hitboxSize = new(1.2f, 1f);
    public float hitboxDelay = 0.15f;
    public float hitboxDuration = 0.12f;

    [Header("Patrol (opcional)")]
    public Transform[] patrolPoints;

    [Header("Daño recibido")]
    public float hurtDuration = 0.35f;

    [Header("Referencias")]
    public Transform target;
    public Rigidbody2D rb;
    public Animator animator;
    public HitBox hb;

    private enum State { Idle, Patrolling, Chasing, Attacking, Hurt, Dead }
    private State _state = State.Idle;

    private float _attackTimer;
    private Coroutine _attackCoroutine;
    private Coroutine _hurtCoroutine;

    private int _patrolIndex = 0;

    private HealthComponent _health;

    private float _posX;
    private float _floorY;
    private float _lastFrameSpeed;

    void Awake()
    {
        if (rb == null) rb = GetComponent<Rigidbody2D>();
        if (animator == null) animator = GetComponent<Animator>();
        if (hb == null) hb = GetComponent<HitBox>();

        rb.bodyType = RigidbodyType2D.Kinematic;
        rb.gravityScale = 0f;
        rb.constraints = RigidbodyConstraints2D.FreezeRotation;

        _health = GetComponent<HealthComponent>();
        if (_health == null) _health = gameObject.AddComponent<HealthComponent>();

        _health.OnDeath += OnDeath;
        _health.OnHealthChanged += (cur, max) => Debug.Log($"[Enemy] HP: {cur}/{max}");

        HurtBox ownHurtBox = GetComponent<HurtBox>();
        if (ownHurtBox != null)
            ownHurtBox.OnHitReceived += OnHurtBoxHit;
    }

    void Start()
    {
        _posX = transform.position.x;
        _floorY = Mathf.Clamp(transform.position.y, floorMin, floorMax);

        FindTarget();
        _state = patrolPoints != null && patrolPoints.Length > 0
            ? State.Patrolling
            : State.Idle;
    }

    void Update()
    {
        if (_state == State.Dead || _state == State.Hurt) return;
        if (target == null) return;

        float distance = Vector2.Distance(
            new Vector2(_posX, _floorY),
            new Vector2(target.position.x, target.position.y));

        switch (_state)
        {
            case State.Idle:
                if (distance <= detectRange) _state = State.Chasing;
                break;

            case State.Patrolling:
                if (distance <= detectRange) _state = State.Chasing;
                break;

            case State.Chasing:
                if (distance <= attackRange)
                {
                    _lastFrameSpeed = 0f;
                    animator.SetFloat("Speed", 0f);
                    _state = State.Attacking;
                    _attackTimer = attackCooldown;
                }
                else if (distance > detectRange * 1.5f)
                {
                    _state = patrolPoints != null && patrolPoints.Length > 0
                        ? State.Patrolling
                        : State.Idle;
                }
                break;

            case State.Attacking:
                _attackTimer -= Time.deltaTime;

                if (distance > attackRange)
                {
                    _state = State.Chasing;
                    break;
                }

                if (_attackTimer <= 0f)
                {
                    _attackTimer = attackCooldown;
                    if (_attackCoroutine != null) StopCoroutine(_attackCoroutine);
                    _attackCoroutine = StartCoroutine(AttackRoutine());
                }
                break;
        }

        animator.SetFloat("Speed", _lastFrameSpeed);
    }

    void FixedUpdate()
    {
        if (_state == State.Dead || _state == State.Hurt) return;

        float dt = Time.fixedDeltaTime;

        if (_state == State.Chasing) MoveToTarget(dt);
        if (_state == State.Patrolling) Patrol(dt);

        _posX = Mathf.Clamp(_posX, xMin, xMax);
        _floorY = Mathf.Clamp(_floorY, floorMin, floorMax);

        rb.MovePosition(new Vector2(_posX, _floorY));
    }

    void MoveToTarget(float dt)
    {
        float tx = target.position.x;
        float ty = target.position.y;

        float dx = tx - _posX;
        float dy = ty - _floorY;
        float dist = Mathf.Sqrt(dx * dx + dy * dy);

        if (dist < 0.01f) { _lastFrameSpeed = 0f; return; }

        float nx = dx / dist;
        float ny = dy / dist;

        _posX += nx * moveSpeed * dt;
        _floorY += ny * moveSpeed * dt;

        _lastFrameSpeed = moveSpeed;
        FaceDirection(nx);
    }

    void Patrol(float dt)
    {
        if (patrolPoints == null || patrolPoints.Length == 0) return;

        Transform wp = patrolPoints[_patrolIndex];
        float dx = wp.position.x - _posX;
        float dy = wp.position.y - _floorY;
        float dist = Mathf.Sqrt(dx * dx + dy * dy);

        if (dist < 0.25f)
        {
            _patrolIndex = (_patrolIndex + 1) % patrolPoints.Length;
            _lastFrameSpeed = 0f;
            return;
        }

        float patrolSpeed = moveSpeed * 0.5f;
        _posX += (dx / dist) * patrolSpeed * dt;
        _floorY += (dy / dist) * patrolSpeed * dt;

        _lastFrameSpeed = patrolSpeed;
        FaceDirection(dx / dist);
    }

    void FaceDirection(float xDir)
    {
        if (xDir == 0f) return;
        transform.localScale = new Vector3(Mathf.Sign(xDir), 1f, 1f);
    }

    IEnumerator AttackRoutine()
    {
        animator.SetTrigger("Attack");
        yield return new WaitForSeconds(hitboxDelay);
        SpawnHitbox();
    }

    void SpawnHitbox()
    {
        if (hitboxPrefab == null || hitboxSpawnPoint == null) return;

        GameObject go = Instantiate(
            hitboxPrefab,
            hitboxSpawnPoint.position,
            Quaternion.identity);

        HitBox spawnedHitBox = go.GetComponent<HitBox>();
        if (spawnedHitBox != null)
            spawnedHitBox.Activate();

        Destroy(go, hitboxDuration);
    }

    private void OnHurtBoxHit(HitData data)
    {
        ReceiveHit(data.damage);
    }

    public void ReceiveHit(float damage)
    {
        if (_state == State.Dead) return;

        _health.TakeDamage(damage);

        if (_attackCoroutine != null) StopCoroutine(_attackCoroutine);
        if (_hurtCoroutine != null) StopCoroutine(_hurtCoroutine);

        _hurtCoroutine = StartCoroutine(HurtRoutine());
    }

    IEnumerator HurtRoutine()
    {
        _state = State.Hurt;
        _lastFrameSpeed = 0f;
        animator.SetFloat("Speed", 0f);
        animator.SetTrigger("Hurt");

        yield return new WaitForSeconds(hurtDuration);

        if (_state != State.Dead)
            _state = State.Chasing;
    }

    void OnDeath()
    {
        _state = State.Dead;
        _lastFrameSpeed = 0f;
        animator.SetTrigger("Die");

        if (_attackCoroutine != null) StopCoroutine(_attackCoroutine);
        if (_hurtCoroutine != null) StopCoroutine(_hurtCoroutine);

        GetComponent<Collider2D>().enabled = false;

        ScoreManager.Instance?.RegisterEnemyKilled();

        Destroy(gameObject, 2.5f);
    }

    void FindTarget()
    {
        GameObject player = GameObject.FindGameObjectWithTag("Player");
        if (player != null) target = player.transform;
    }

    void OnDrawGizmosSelected()
    {
        Gizmos.color = Color.yellow;
        Gizmos.DrawWireSphere(transform.position, detectRange);

        Gizmos.color = Color.red;
        Gizmos.DrawWireSphere(transform.position, attackRange);
    }
}