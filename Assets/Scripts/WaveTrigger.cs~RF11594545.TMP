using UnityEngine;

// ================================================================
//  WAVE TRIGGER — Activador de oleada por zona
//
//  Coloca un GameObject con Collider2D (isTrigger = true) en el
//  punto del escenario donde quieras que arranque una oleada.
//  Cuando el jugador entre, llamará a WaveManager.StartWave(index).
// ================================================================

[RequireComponent(typeof(Collider2D))]
public class WaveTrigger : MonoBehaviour
{
    [Header("Referencias")]
    [SerializeField] private WaveManager waveManager;

    [Header("Configuración")]
    [SerializeField] private int    waveIndex = 0;
    [SerializeField] private string playerTag = "Player";

    [Tooltip("Si está marcado, este trigger desaparece tras usarse una vez.")]
    [SerializeField] private bool oneShot = true;

    private bool triggered;

    private void Reset()
    {
        // Por comodidad en el editor
        var col = GetComponent<Collider2D>();
        col.isTrigger = true;
    }

    private void OnTriggerEnter2D(Collider2D other)
    {
        if (triggered) return;
        if (!other.CompareTag(playerTag)) return;
        if (waveManager == null)
        {
            Debug.LogWarning("[WaveTrigger] Falta la referencia a WaveManager.");
            return;
        }

        triggered = true;
        waveManager.StartWave(waveIndex);

        if (oneShot) gameObject.SetActive(false);
    }

    private void OnDrawGizmos()
    {
        var col = GetComponent<Collider2D>();
        if (col == null) return;

        Gizmos.color = new Color(1f, 0.5f, 0f, 0.35f);
        Gizmos.DrawCube(col.bounds.center, col.bounds.size);
        Gizmos.color = new Color(1f, 0.5f, 0f, 1f);
        Gizmos.DrawWireCube(col.bounds.center, col.bounds.size);
    }
}
